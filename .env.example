# ========================================================
# EV CHARGING STATION MANAGEMENT SYSTEM (EV CSMS)
# Environment Configuration Template
# ========================================================

# --- Project Info ---
PROJECT_NAME="EV Charging Station Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- Security & JWT Authentication ---
SECRET_KEY="supersecret_ev_csms_key_for_development_jwt_auth_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
MAX_FAILED_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION_MINUTES=15
IDLE_FEE_MAX_MINUTES=240

# --- Database Connection ---
# SQLite local (Giai đoạn 1 MVP - mặc định)
DATABASE_URL="sqlite:///./ev_csms.db"
# PostgreSQL (Giai đoạn 2 - Cloud/Docker)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ev_csms_db"

# --- CORS Settings ---
# JSON array chứa các origin được phép kết nối frontend
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# --- AI Engine (Google Gemini) ---
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-3.5-flash-lite"

# --- Simulator & Telemetry ---
SIMULATOR_INTERVAL_SECONDS=2

# --- OCPP Smart Charging ---
HEARTBEAT_INTERVAL_SECONDS=300
STATION_NEARBY_DEFAULT_LIMIT=20
STATION_NEARBY_MAX_LIMIT=50
REBALANCE_MIN_INTERVAL_SECONDS=5

# --- SePay Payment Gateway & Webhook ---
SEPAY_WEBHOOK_SECRET="whsec_lsoxfnnWmlImodkfHIJMsUNi5Jap1Tm5"
SEPAY_MERCHANT_ID="SP-TEST-QM7A94B7"
SEPAY_MERCHANT_SECRET="spsk_test_AmXjk1q4xk8G73fSYpxWaoh42NM5c7wq"
SEPAY_ENV="sandbox"
