# ========================================================
# EV CHARGING STATION MANAGEMENT SYSTEM (EV CSMS)
# Environment Configuration Template
# ========================================================

# --- Project Info ---
PROJECT_NAME="EV Charging Station Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# --- Security & JWT Authentication ---
SECRET_KEY="supersecret_ev_csms_key_for_development_jwt_auth_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Database Connection ---
# SQLite local (Giai đoạn 1 MVP - mặc định)
DATABASE_URL="sqlite:///./ev_csms.db"
# PostgreSQL (Giai đoạn 2 - Cloud/Docker)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/ev_csms_db"

# --- CORS Settings ---
# JSON array chứa các origin được phép kết nối frontend
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# --- AI Engine (Google Gemini) ---
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-3.5-flash-lite"

# --- Simulator & Telemetry ---
SIMULATOR_INTERVAL_SECONDS=2
