# ========================================================
# EV CHARGING STATION MANAGEMENT SYSTEM (EV CSMS)
# Backend Environment Configuration
# ========================================================

PROJECT_NAME="EV Charging Station Management System"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# JWT Auth
SECRET_KEY="supersecret_ev_csms_key_for_development_jwt_auth_change_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# SQLite Local Database (Giai đoạn 1 MVP)
DATABASE_URL="sqlite:///./ev_csms.db"

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:5173"]

# AI Gemini
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-1.5-flash"

# Simulator Interval
SIMULATOR_INTERVAL_SECONDS=2
