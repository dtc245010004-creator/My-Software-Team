# Server Configuration
PROJECT_NAME="Hệ Thống Quản Lý Kho Tích Hợp AI"
VERSION="1.0.0"
API_V1_STR="/api/v1"

# Security & JWT
SECRET_KEY="kho_ai_secret_key_change_me_in_production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database (Default to SQLite file in data/ or root)
