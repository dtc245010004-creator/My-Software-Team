from sqlalchemy.orm import Session
from sqlalchemy.exc import IntegrityError
from datetime import datetime
from app.models.station import Station

def validate_coordinates(latitude, longitude):
    """Kiểm tra tính hợp lệ của tọa độ vĩ độ và kinh độ"""
    if latitude is not None and (latitude < -90 or latitude > 90):
        raise ValueError('Vĩ độ phải nằm trong khoảng từ -90 đến 90')
    if longitude is not None and (longitude < -180 or longitude > 180):
        raise ValueError('Kinh độ phải nằm trong khoảng từ -180 đến 180')

def create_station(session: Session, station_data: dict, user):
    """Xử lý nghiệp vụ tạo trạm sạc mới gắn với chủ trạm (owner_id)"""
    validate_coordinates(station_data.get('latitude'), station_data.get('longitude'))
    
    station = Station(
        name=station_data.get('name'),
        address=station_data.get('address'),
        latitude=station_data.get('latitude'),
        longitude=station_data.get('longitude'),
        status='inactive', # Mặc định trạng thái ban đầu
        owner_id=user.id   # Gắn với ID của user đang đăng nhập
    )
    try:
        session.add(station)
        session.commit()
        session.refresh(station)
        return station
    except IntegrityError:
        session.rollback()
        raise ValueError("Lỗi cơ sở dữ liệu khi tạo trạm")

def update_station(session: Session, station_id: int, station_data: dict, user):
    """Xử lý nghiệp vụ cập nhật thông tin trạm sạc"""
    # Chỉ cho phép sửa nếu đúng trạm thuộc quyền sở hữu của user (hoặc thêm điều kiện admin)
    station = session.query(Station).filter_by(id=station_id, owner_id=user.id).first()
    if not station:
        raise ValueError("Không tìm thấy trạm hoặc bạn không có quyền chỉnh sửa trạm này")
    
    validate_coordinates(station_data.get('latitude'), station_data.get('longitude'))

    station.name = station_data.get('name', station.name)
    station.address = station_data.get('address', station.address)
    station.latitude = station_data.get('latitude', station.latitude)
    station.longitude = station_data.get('longitude', station.longitude)
    station.updated_at = datetime.utcnow()
    
    session.commit()
    session.refresh(station)
    return station