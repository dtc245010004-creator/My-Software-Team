API_PORT=8000
API_BIND=127.0.0.1
FRONTEND_BIND=0.0.0.0
GEMINI_API_KEY=
BOOTSTRAP_ADMIN_EMAIL=admin@staging.example
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-before-first-start
BOOTSTRAP_STATION_OWNER_EMAIL=owner@staging.example
BOOTSTRAP_STATION_OWNER_USERNAME=station_owner
BOOTSTRAP_STATION_OWNER_PASSWORD=replace-before-first-start
